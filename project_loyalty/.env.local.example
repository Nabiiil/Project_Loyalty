# ─── QR token signing secret ─────────────────────────────────────────────────
# Must be at least 32 characters. Can be any random string for local dev.
QR_TOKEN_SECRET=change-me-to-a-random-32-char-minimum-secret

# ─── App origin (only needed for cross-device QR testing) ────────────────────
# Set this to your machine's LAN IP when you want to scan QR codes from a phone
# on the same network. Leave commented out for normal browser-only testing.
# NEXT_PUBLIC_APP_URL=http://192.168.x.x:3000
